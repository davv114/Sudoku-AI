# ------------------------------------------------------------------
# Copia questo file in ".env" e inserisci la tua API key.
# Il file ".env" è già ignorato da Git: NON pubblicare mai la chiave.
#
# La chiave si ottiene gratuitamente da Google AI Studio:
# https://aistudio.google.com/apikey
# ------------------------------------------------------------------

GEMINI_API_KEY=incolla_qui_la_tua_chiave

# Modello consigliato per OCR e spiegazioni (ottimizzato per velocità).
GEMINI_MODEL=gemini-3.5-flash-lite

# Modelli provati in ordine se il precedente è stato ritirato (404) o è
# sovraccarico (503). Separati da virgola. Lasciare vuoto per disattivare.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.8-flash,gemini-3.6-flash,gemini-flash-latest

# Porta del server locale (default 8765).
PORT=8765

# Indirizzo di ascolto. 127.0.0.1 = solo questo PC, 0.0.0.0 = raggiungibile
# anche dalla LAN (serve per aprire l'app dal telefono sulla stessa Wi-Fi).
HOST=127.0.0.1
